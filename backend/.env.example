# Copy to backend/.env for local development. Production values come from the operator.
EAGLE_DATABASE_URL=sqlite+aiosqlite:///./eagle.db
EAGLE_SECRET_KEY=change-me-to-a-long-random-string
EAGLE_BOOTSTRAP_ADMIN_USERNAME=admin
EAGLE_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
# Generate with: uv run eagle generate-key
EAGLE_ENCRYPTION_KEY=

# Links in notifications and PR comments point here.
EAGLE_PUBLIC_URL=http://localhost:5173

# local: run agent CLIs as subprocesses; mock: canned reviews, no model calls;
# kubernetes: one Job per review (production).
EAGLE_EXECUTOR=local

# Optional OIDC SSO (Red Hat SSO / Keycloak). Register this redirect URI with the IdP:
#   <EAGLE_PUBLIC_URL>/api/v1/auth/oidc/callback
# EAGLE_OIDC_ISSUER=https://sso.example.com/realms/engineering
# EAGLE_OIDC_CLIENT_ID=eagle
# EAGLE_OIDC_CLIENT_SECRET=
# EAGLE_OIDC_ADMIN_GROUPS=["eagle-admins"]
# EAGLE_OIDC_MEMBER_GROUPS=["eagle-members"]
# EAGLE_OIDC_DEFAULT_ROLE=viewer
# EAGLE_LOCAL_LOGIN_ENABLED=true
