# Non secret settings shared by web and worker. Edit before `oc apply -k`.
# External URL of the Route (https://<host>). Must match route.yaml spec.host,
# or the host OpenShift assigns (see deploy/README.md).
EAGLE_PUBLIC_URL=https://eagle.apps.example.com
EAGLE_BOOTSTRAP_ADMIN_USERNAME=admin
# Agent runner image used for review Jobs.
EAGLE_RUNNER_IMAGE=quay.io/hmoghani/eagle-agent-runner:v0.1.0
EAGLE_RUNNER_CPU_LIMIT=2
EAGLE_RUNNER_MEMORY_LIMIT=4Gi
