# Optional OpenID Connect SSO for the web container. To enable:
#   1. Uncomment the eagle-sso configMapGenerator in kustomization.yaml.
#   2. Uncomment the envFrom block on the web container in web.yaml.
#   3. Create the client secret:
#        oc create secret generic eagle-oidc -n eagle \
#          --from-literal=EAGLE_OIDC_CLIENT_SECRET='<client secret>'
#   4. Register this redirect URI with the IdP:
#        <EAGLE_PUBLIC_URL>/api/v1/auth/oidc/callback
# Group lists must be JSON arrays.
EAGLE_OIDC_ISSUER=https://sso.example.com/realms/example
EAGLE_OIDC_CLIENT_ID=eagle
EAGLE_OIDC_SCOPES=openid email profile
EAGLE_OIDC_BUTTON_LABEL=Sign in with SSO
EAGLE_OIDC_USERNAME_CLAIM=preferred_username
EAGLE_OIDC_GROUPS_CLAIM=groups
EAGLE_OIDC_ADMIN_GROUPS=["eagle-admins"]
EAGLE_OIDC_MEMBER_GROUPS=["eagle-members"]
EAGLE_OIDC_VIEWER_GROUPS=[]
# admin, member, viewer or none
EAGLE_OIDC_DEFAULT_ROLE=viewer
# Keep local username/password login as break glass.
EAGLE_LOCAL_LOGIN_ENABLED=true
